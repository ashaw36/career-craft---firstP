{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerCraft",
  "mainBinaryName": "careercraft-desktop",
  "version": "0.1.0",
  "identifier": "com.careercraft.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "CareerCraft",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
